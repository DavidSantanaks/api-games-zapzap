# League of Legends — obtenha em https://developer.riotgames.com/
# A chave de desenvolvimento expira em 24 horas.
# Após trocar qualquer chave: docker compose up -d --force-recreate
RIOT_API_KEY=

# Counter-Strike 2 — obtenha em https://steamcommunity.com/dev/apikey
# Usada para resolver perfis SteamID64 e consultar GetNextMatchSharingCode da Valve.
STEAM_API_KEY=

# Counter-Strike 2 (opcional) — obtenha em https://leetify.com/app/developer
# Amplia o limite de consultas das estatísticas extraídas das demos (.dem).
LEETIFY_API_KEY=

# Intervalo inicial; depois pode ser alterado pela interface (mínimo: 30 segundos).
POLL_INTERVAL_SECONDS=120

# Opcional: senha para proteger a interface por HTTP Basic.
# Usuário: admin. Configure antes de expor além do localhost.
APP_PASSWORD=

# Para execução sem Docker. No container estas duas opções são fixadas no compose.
PORT=3000
DATA_DIR=./data
